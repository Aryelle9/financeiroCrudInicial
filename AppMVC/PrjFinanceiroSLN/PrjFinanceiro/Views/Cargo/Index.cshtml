@model IEnumerable<PrjFinanceiro.Models.Cargo>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Cargos -  @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Cargo/Criar" class="btn btn-success">Cadastrar Novo Cargo</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome do Cargo</th>
                <th>Descricao</th>
                <th>Abreviacao</th>
               
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>@item.Abreviacao</td>
                    
                    <td>
                        <a href="/Cargo/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Cargo/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>